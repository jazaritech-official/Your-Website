{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 60, "maxBodySize": "50mb" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "index.js" }
  ],
  "crons": [
    {
      "path": "/api/v1/bulk-product/maintenance/recover-stale-jobs",
      "schedule": "0 3 * * *"
    }
  ]
}